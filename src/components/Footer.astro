---
// src/components/Footer.astro
import { getApiUrl } from '@/lib/api';

interface SocialLink {
  platform: string;
  url: string;
  icon: string;
}

interface SiteConfig {
  siteName: string;
  tagline: string;
  social_links: SocialLink[];
  cv_url?: string;
}

// Fetch site config from Hono API
let siteConfig: SiteConfig | null = null;
let error = false;

try {
  const response = await fetch(`${getApiUrl()}/api/site-config`);
  if (response.ok) {
    const data = await response.json();
    siteConfig = data.config;
  }
} catch (e) {
  console.error('Failed to fetch site config:', e);
  error = true;
}

const socialLinks = siteConfig?.social_links || [
  { platform: 'github', url: 'https://github.com', icon: 'github' },
  { platform: 'twitter', url: 'https://twitter.com', icon: 'twitter' },
  { platform: 'linkedin', url: 'https://linkedin.com', icon: 'linkedin' },
];

const getSocialIcon = (platform: string) => {
  const icons: Record<string, string> = {
    github: '→ GitHub',
    twitter: '→ Twitter',
    linkedin: '→ LinkedIn',
    instagram: '→ Instagram',
    discord: '→ Discord',
    email: '→ Email',
    website: '→ Website',
  };
  return icons[platform] || `→ ${platform}`;
};
---

<footer class="footer">
  <div class="footer-content">
    <!-- Copyright -->
    <div class="footer-section">
      <p class="copyright">
        © {new Date().getFullYear()} Wyss. All rights reserved.
      </p>
    </div>

    <!-- Social Links -->
    <div class="footer-section social-links">
      <nav class="socials" aria-label="Social links">
        {socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label={link.platform}
            transition:animate="fade"
          >
            {getSocialIcon(link.platform)}
          </a>
        ))}
      </nav>
    </div>

    <!-- CV Link -->
    {siteConfig?.cv_url && (
      <div class="footer-section">
        <a href={siteConfig.cv_url} class="cv-link" download>
          → Download CV
        </a>
      </div>
    )}

    <!-- Theme Info -->
    <div class="footer-section theme-info">
      <p class="theme-info-title">Current theme:</p>
      <ul class="theme-info-list">
        <li id="footer-weather"></li>
        <li id="footer-daytime"></li>
        <li id="footer-season"></li>
      </ul>
    </div>
  </div>

  <!-- Divider -->
  <div class="footer-divider"></div>

  <!-- Bottom Text -->
  <div class="footer-bottom">
    <p class="tagline">
      {siteConfig?.tagline || 'Building beautiful, functional web experiences'}
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-color, rgba(0, 0, 0, 0.1));
    padding: 4rem 2rem 2rem;
    margin-top: 8rem;
    background: var(--footer-bg, rgba(255, 255, 255, 0.5));
    backdrop-filter: blur(10px);
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer-section {
    animation: slideUp 0.6s ease-out backwards;
  }

  .footer-section:nth-child(2) {
    animation-delay: 0.1s;
  }

  .footer-section:nth-child(3) {
    animation-delay: 0.2s;
  }

  .footer-section:nth-child(4) {
    animation-delay: 0.3s;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .copyright {
    font-size: 0.875rem;
    color: var(--text-secondary, rgba(0, 0, 0, 0.6));
    margin: 0;
  }

  .socials {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .social-link {
    color: var(--text-primary, #000);
    text-decoration: none;
    font-size: 0.95rem;
    padding: 0.5rem 0;
    transition: all 0.3s ease;
    position: relative;
  }

  .social-link::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--accent, #0066ff);
    transition: width 0.3s ease;
  }

  .social-link:hover {
    color: var(--accent, #0066ff);
  }

  .social-link:hover::before {
    width: 100%;
  }

  .cv-link {
    color: var(--text-primary, #000);
    text-decoration: none;
    font-size: 0.95rem;
    padding: 0.5rem;
    transition: all 0.3s ease;
    display: inline-block;
    border: 1px solid var(--border-color, rgba(0, 0, 0, 0.1));
    border-radius: 4px;
  }

  .cv-link:hover {
    background: var(--accent, #0066ff);
    color: white;
    border-color: var(--accent, #0066ff);
  }

  .theme-info-title {
    font-size: 0.875rem;
    color: var(--text-secondary, rgba(0, 0, 0, 0.6));
    margin: 0;
  }

  .theme-info-list {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--text-secondary, rgba(0, 0, 0, 0.6));
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .footer-divider {
    height: 1px;
    background: var(--border-color, rgba(0, 0, 0, 0.1));
    margin: 2rem 0;
  }

  .footer-bottom {
    text-align: center;
    padding-top: 1rem;
  }

  .tagline {
    font-size: 0.875rem;
    color: var(--text-secondary, rgba(0, 0, 0, 0.6));
    margin: 0;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 2rem 1rem 1rem;
      margin-top: 4rem;
    }

    .footer-content {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
