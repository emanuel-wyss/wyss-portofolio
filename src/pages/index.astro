---
// src/pages/index.astro
import Layout from '@/layouts/Layout.astro';
import { getFeed, getSiteConfig } from '@/lib/api';

const feed = await getFeed(1, 5, 'all');
const siteConfig = await getSiteConfig();
---

<Layout
  title="Home"
  description={siteConfig?.seo?.metaDescription || 'Full-stack developer, designer, and builder'}
  image={siteConfig?.seo?.ogImage}
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <h1 transition:animate="fade">Welcome to wyss.rocks</h1>
      <p class="tagline" transition:animate="fade">
        {siteConfig?.tagline || 'Building beautiful, functional web experiences'}
      </p>
      <div class="cta-buttons">
        <a href="/about" class="btn btn-primary" transition:animate="fade">
          Learn More
        </a>
        <a href="/work" class="btn btn-secondary">
          View My Work
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Content -->
  {feed.items.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>Latest</h2>
        <div class="grid grid-3">
          {feed.items.map((item, index) => (
            <article class="card" style={`animation-delay: ${index * 100}ms`}>
              <span class={`type-badge type-${item.type}`}>
                {item.type === 'post' ? '📝 Post' : item.type === 'snippet' ? '💻 Snippet' : '📸 Gallery'}
              </span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <div class="meta">
                {item.category && <span class="category">{item.category}</span>}
                {item.language && <span class="category">{item.language}</span>}
                <span class="date">
                  {new Date(item.publishedAt).toLocaleDateString()}
                </span>
              </div>
              <a
                href={item.type === 'post' ? `/posts/${item.slug}` : item.type === 'snippet' ? `/snippets/${item.slug}` : `/gallery/${item.slug}`}
                class="read-more"
              >
                {item.type === 'post' ? 'Read More' : item.type === 'snippet' ? 'View Snippet' : 'View Album'} →
              </a>
            </article>
          ))}
        </div>
        <a href="/work" class="view-all">View All →</a>
      </div>
    </section>
  )}
</Layout>

<style>
  .hero {
    padding: var(--spacing-2xl) 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 600px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, var(--accent-light) 0%, transparent 70%);
    border-radius: 50%;
    z-index: -1;
  }

  .hero .container {
    text-align: center;
    z-index: 1;
  }

  .hero h1 {
    font-size: 4rem;
    margin-bottom: var(--spacing-md);
  }

  .tagline {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: var(--spacing-xl);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-buttons {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: var(--spacing-md) var(--spacing-lg);
    border-radius: 8px;
    font-weight: 500;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .btn-primary {
    background: var(--accent);
    color: white;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 102, 255, 0.3);
  }

  .btn-secondary {
    border: 2px solid var(--accent);
    color: var(--accent);
  }

  .btn-secondary:hover {
    background: var(--accent-light);
  }

  .section {
    padding: var(--spacing-2xl) 0;
    border-bottom: 1px solid var(--border-color);
  }

  .section.alternate {
    background: var(--bg-secondary);
  }

  .section h2 {
    margin-bottom: var(--spacing-xl);
  }

  .card {
    padding: var(--spacing-lg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    transition: all 0.3s ease;
    animation: slideInRight 0.6s ease-out backwards;
  }

  .card:hover {
    transform: translateY(-8px);
    border-color: var(--accent);
    box-shadow: 0 20px 40px rgba(0, 102, 255, 0.1);
  }

  .card h3 {
    margin-bottom: var(--spacing-sm);
    font-size: 1.25rem;
  }

  .card p {
    margin-bottom: var(--spacing-md);
    color: var(--text-secondary);
  }

  .meta {
    display: flex;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-md);
    font-size: 0.875rem;
  }

  .category {
    background: var(--accent-light);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    color: var(--accent);
    font-weight: 500;
  }

  .date {
    color: var(--text-secondary);
  }

  .read-more {
    color: var(--accent);
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .read-more:hover {
    gap: var(--spacing-sm);
  }

  .type-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
  }

  .type-post {
    background: var(--accent-light);
    color: var(--accent);
  }

  .type-snippet {
    background: rgba(76, 175, 80, 0.15);
    color: #4CAF50;
  }

  .type-gallery {
    background: rgba(255, 152, 0, 0.15);
    color: #FF9800;
  }

  .view-all {
    display: block;
    text-align: center;
    margin-top: var(--spacing-xl);
    color: var(--accent);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 400px;
      padding: var(--spacing-xl) 0;
    }

    .hero h1 {
      font-size: 2.5rem;
    }

    .tagline {
      font-size: 1rem;
    }

    .cta-buttons {
      flex-direction: column;
    }

    .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
