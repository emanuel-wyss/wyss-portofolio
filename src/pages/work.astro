---
// src/pages/work.astro
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Work"
  description="Browse all posts, code snippets, and photo galleries"
>
  <section class="work-page">
    <div class="container">
      <h1 transition:animate="fade">Work</h1>
      <p class="subtitle">Posts, snippets, and galleries</p>
      <content-feed mode="work" limit="12" type="all" cache-key="feed:work:v1"></content-feed>
    </div>
  </section>
</Layout>

<style>
  .work-page {
    padding: var(--spacing-2xl) 0;
    min-height: 80vh;
  }

  .work-page h1 {
    font-size: 3rem;
    margin-bottom: var(--spacing-sm);
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin-bottom: var(--spacing-xl);
  }

  @media (max-width: 768px) {
    .work-page h1 {
      font-size: 2rem;
    }
  }
</style>
