---
// src/pages/about.astro
import Layout from '@/layouts/Layout.astro';
import { getSiteConfig } from '@/lib/api';

const siteConfig = await getSiteConfig();

const skills = [
  { category: 'Frontend', items: ['TypeScript', 'React', 'Astro', 'Next.js', 'Tailwind CSS'] },
  { category: 'Backend', items: ['Node.js', 'Bun', 'Hono', 'Payload CMS', 'PostgreSQL'] },
  { category: 'DevOps', items: ['Docker', 'Railway', 'GitHub Actions', 'Nixpacks'] },
  { category: 'Tools', items: ['Git', 'VS Code', 'Figma', 'Linux'] },
];

const getSocialIcon = (platform: string) => {
  const icons: Record<string, string> = {
    github: '→ GitHub',
    twitter: '→ Twitter',
    linkedin: '→ LinkedIn',
    instagram: '→ Instagram',
    discord: '→ Discord',
    email: '→ Email',
    website: '→ Website',
  };
  return icons[platform] || `→ ${platform}`;
};
---

<Layout
  title="About"
  description={siteConfig?.description || 'Learn more about me'}
  type="profile"
>
  <section class="about-page">
    <div class="container">
      <!-- Header -->
      <div class="about-header" transition:animate="fade">
        <h1>{siteConfig?.siteName || 'Wyss'}</h1>
        <p class="location">📍 Switzerland</p>
        <p class="bio">
          {siteConfig?.description || siteConfig?.tagline || 'Full-stack developer building beautiful, functional web experiences.'}
        </p>
      </div>

      <!-- Skills -->
      <div class="skills-section">
        <h2>Skills & Tech Stack</h2>
        <div class="skills-grid">
          {skills.map((group) => (
            <div class="skill-group">
              <h3>{group.category}</h3>
              <ul>
                {group.items.map((skill) => (
                  <li>{skill}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Social Links -->
      {siteConfig?.social_links && siteConfig.social_links.length > 0 && (
        <div class="social-section">
          <h2>Connect</h2>
          <nav class="social-grid" aria-label="Social links">
            {siteConfig.social_links.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="social-card"
              >
                {getSocialIcon(link.platform)}
              </a>
            ))}
          </nav>
        </div>
      )}

      <!-- CV Download -->
      {siteConfig?.cv_url && (
        <div class="cv-section">
          <a href={siteConfig.cv_url} class="btn btn-cv" download>
            📄 Download CV
          </a>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .about-page {
    padding: var(--spacing-2xl) 0;
    min-height: 80vh;
  }

  .about-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .about-header h1 {
    font-size: 3rem;
    margin-bottom: var(--spacing-sm);
  }

  .location {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: var(--spacing-md);
  }

  .bio {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .skills-section,
  .social-section {
    margin-bottom: var(--spacing-2xl);
  }

  .skills-section h2,
  .social-section h2 {
    margin-bottom: var(--spacing-lg);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-lg);
  }

  .skill-group {
    padding: var(--spacing-lg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    transition: all 0.3s ease;
  }

  .skill-group:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
  }

  .skill-group h3 {
    font-size: 1rem;
    margin-bottom: var(--spacing-md);
    color: var(--accent);
  }

  .skill-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .skill-group li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    padding: 0.25rem 0;
  }

  .social-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  .social-card {
    padding: var(--spacing-md) var(--spacing-lg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .social-card:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .cv-section {
    text-align: center;
    margin-top: var(--spacing-xl);
  }

  .btn-cv {
    display: inline-block;
    padding: var(--spacing-md) var(--spacing-xl);
    border: 2px solid var(--accent);
    border-radius: 8px;
    color: var(--accent);
    font-weight: 500;
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .btn-cv:hover {
    background: var(--accent);
    color: white;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .about-header h1 {
      font-size: 2rem;
    }

    .skills-grid {
      grid-template-columns: 1fr 1fr;
    }

    .social-grid {
      flex-direction: column;
    }
  }
</style>
