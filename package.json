{
  "name": "wyss-portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio with TanStack Router, Hono, Payload CMS, and Cloudflare R2",
  "type": "module",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "bun --bun src/dev.ts",
    "build": "bun --bun vite build && bun --bun build:server",
    "build:server": "bun build ./server/index.ts --outdir ./dist --format esm --target bun",
    "start": "bun dist/index.js",
    "preview": "vite preview",
    "payload": "PAYLOAD_CONFIG_PATH=server/payload/config.ts ./node_modules/.bin/payload",
    "migrate": "PAYLOAD_CONFIG_PATH=server/payload/config.ts ./node_modules/.bin/payload migrate",
    "migrate:create": "PAYLOAD_CONFIG_PATH=server/payload/config.ts ./node_modules/.bin/payload migrate:create",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "deploy": "bunx @railway/cli up --service web --detach && bunx @railway/cli up ./admin --path-as-root --service admin --detach",
    "deploy:fe": "bunx @railway/cli up --service web --detach",
    "deploy:admin": "bunx @railway/cli up ./admin --path-as-root --service admin --detach"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.85.0",
    "@payloadcms/plugin-cloud-storage": "^3.85.0",
    "@payloadcms/richtext-lexical": "^3.85.0",
    "@payloadcms/storage-s3": "^3.85.0",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "clsx": "^2.1.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.40.0",
    "hono": "^4.12.23",
    "payload": "^3.85.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@storybook/blocks": "^8.6.14",
    "@storybook/test": "^8.6.15",
    "@storybook/test-runner": "^0.24.4",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "@vitejs/plugin-react": "^6.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.4.0",
    "happy-dom": "^20.9.0",
    "storybook": "^10.4.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.7",
    "@types/bun": "^1.3.14"
  },
  "private": true
}
