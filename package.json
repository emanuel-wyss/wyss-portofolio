{
  "name": "wyss-portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio with TanStack Router, Hono, Payload CMS, and Cloudflare R2",
  "type": "module",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "bun --bun src/dev.ts",
    "build": "bun --bun vite build && bun --bun build:server",
    "build:server": "bun build ./server/index.ts --outdir ./dist --format esm --target bun",
    "start": "bun dist/index.js",
    "preview": "vite preview",
    "payload": "PAYLOAD_CONFIG_PATH=server/payload/config.ts ./node_modules/.bin/payload",
    "migrate": "PAYLOAD_CONFIG_PATH=server/payload/config.ts ./node_modules/.bin/payload migrate",
    "migrate:create": "PAYLOAD_CONFIG_PATH=server/payload/config.ts ./node_modules/.bin/payload migrate:create",
    "rotate-secrets": "bun --bun scripts/rotate-secrets.ts",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "deploy": "bunx @railway/cli up --service web --detach && bunx @railway/cli up ./admin --path-as-root --service admin --detach",
    "deploy:fe": "bunx @railway/cli up --service web --detach",
    "deploy:admin": "bunx @railway/cli up ./admin --path-as-root --service admin --detach"
  },
  "dependencies": {
    "@fontsource/monaspace-argon": "^5.3.0",
    "@fontsource/monaspace-krypton": "^5.3.0",
    "@fontsource/monaspace-neon": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@payloadcms/db-postgres": "^3.92.1",
    "@payloadcms/plugin-cloud-storage": "^3.92.1",
    "@payloadcms/richtext-lexical": "^3.92.1",
    "@payloadcms/storage-s3": "^3.92.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/router-plugin": "^1.168.48",
    "clsx": "^2.1.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "exif-reader": "^2.0.3",
    "framer-motion": "^12.43.0",
    "hono": "^4.13.14",
    "payload": "^3.92.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@storybook/blocks": "^8.6.14",
    "@storybook/test": "^8.6.15",
    "@storybook/test-runner": "^0.24.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "@vitejs/plugin-react": "^6.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "happy-dom": "^20.14.6",
    "storybook": "^10.6.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "@types/bun": "^1.4.4"
  },
  "private": true
}
